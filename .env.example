# --- Existing IndiHomes backend ---
INDIHOMES_BASE_URL=https://api.indihomes.co.in/api/v1
INDIHOMES_API_KEY=

# --- WATI ---
WATI_API_KEY=
WATI_ENDPOINT=https://live-mt-server.wati.io
WATI_TEMPLATE_NAME=campaign_property_intro
WATI_GENERIC_TEMPLATE_NAME=campaign_generic_intro

# --- Worker tuning (seconds) ---
POLL_INTERVAL_SECONDS=45
RETRY_WORKER_INTERVAL_SECONDS=120
CLEANUP_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=15

# --- Advisor email notifications (POST /notify-advisor) ---
# Brevo only - https://api.brevo.com. Leave BREVO_API_KEY blank to run
# in "log only" mode (useful for local testing before the Brevo
# account is set up).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Indihomes Bookings
ADVISOR_EMAILS=
NOTIFY_CC=

# --- Phase 3: indihomes-lead-routing-service (salesperson notification) ---
# Blank LEAD_ROUTING_URL = the hook in services/campaign_service.py's
# process_lead() is a silent no-op - see integrations/lead_routing_client.py.
LEAD_ROUTING_URL=
LEAD_ROUTING_SHARED_SECRET=
LEAD_ROUTING_DRY_RUN=true
LEAD_ROUTING_TIMEOUT_SECONDS=15

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
