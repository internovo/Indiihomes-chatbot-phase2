# --- Existing IndiHomes backend ---
INDIHOMES_BASE_URL=https://api.indihomes.co.in/api/v1
INDIHOMES_API_KEY=

# --- WATI ---
WATI_API_KEY=
WATI_ENDPOINT=https://live-mt-server.wati.io
WATI_TEMPLATE_NAME=housing_template
WATI_GENERIC_TEMPLATE_NAME=meta_flow2

# --- Worker tuning (seconds) ---
POLL_INTERVAL_SECONDS=45
RETRY_WORKER_INTERVAL_SECONDS=120
CLEANUP_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=15

# --- Advisor email notifications (POST /notify-advisor) ---
# Brevo only - https://api.brevo.com. Leave BREVO_API_KEY blank to run
# in "log only" mode (useful for local testing before the Brevo
# account is set up).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Indihomes Bookings
ADVISOR_EMAILS=
NOTIFY_CC=

# --- Phase 3: indihomes-lead-routing-service (salesperson notification) ---
# Blank LEAD_ROUTING_URL = the hook in services/campaign_service.py's
# process_lead() is a silent no-op - see integrations/lead_routing_client.py.
LEAD_ROUTING_URL=
LEAD_ROUTING_SHARED_SECRET=
LEAD_ROUTING_DRY_RUN=true
LEAD_ROUTING_TIMEOUT_SECONDS=15

# Defaults false as of 2026-08-12 - Meta Ads leads' salesperson
# notifications were going out with "Looking For: -" and "Budget: -"
# because models/lead.py never captured those fields from the CRM at
# all. See claude.md, "Meta Ads salesperson notification disabled",
# before ever setting this to true.
LEAD_ROUTING_META_ADS_ENABLED=false

# --- Lead events (see integrations/os_events_client.py) ---
# Pushes WhatsApp checkpoint events (template_sent, delivered, failed,
# resent) to indihomes-os's Lead Capture screen. Blank OS_EVENTS_URL = the
# hook in services/campaign_service.py / routes/webhook.py /
# workers/meta_resend_worker.py is a silent no-op. Dry-run defaults true
# for the same reason as LEAD_ROUTING_DRY_RUN above - indihomes-os's own
# server.cjs doesn't exist yet as of this writing, see that repo's
# backend/LEAD_EVENTS_INTEGRATION.md.
OS_EVENTS_URL=
OS_EVENTS_SHARED_SECRET=
OS_EVENTS_DRY_RUN=true
OS_EVENTS_TIMEOUT_SECONDS=10

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
